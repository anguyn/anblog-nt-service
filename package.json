{
  "name": "anblog-nt-service",
  "version": "1.0.0",
  "description": "This service 2 is for AnBlog project",
  "author": "An Nguyen",
  "license": "MIT",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:worker": "tsx watch src/workers/index.ts",
    "build": "tsc && tsc-alias",
    "start": "npx pm2-runtime start ecosystem.config.js",
    "start:api": "node dist/index.js",
    "start:worker": "node dist/workers/index.js",
    "pm2:start": "pm2 start ecosystem.config.js",
    "pm2:stop": "pm2 stop all",
    "pm2:restart": "pm2 restart all",
    "pm2:delete": "pm2 delete all",
    "pm2:logs": "pm2 logs",
    "pm2:monit": "pm2 monit",
    "prepare": "husky",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "worker": "node dist/workers/index.js",
    "prisma:generate": "prisma generate",
    "prisma:studio": "prisma studio",
    "db:pull": "prisma db pull",
    "postinstall": "prisma generate"
  },
  "lint-staged": {
    "src/**/*.{js,ts}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "dependencies": {
    "@bull-board/api": "^6.13.1",
    "@bull-board/express": "^6.13.1",
    "@bull-board/ui": "^6.13.1",
    "@prisma/client": "^6.17.1",
    "@socket.io/redis-adapter": "^8.3.0",
    "@vitalets/google-translate-api": "^9.2.1",
    "bullmq": "^5.61.0",
    "cors": "^2.8.5",
    "crypto": "^1.0.1",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "groq-sdk": "^0.34.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.8.1",
    "jsonwebtoken": "^9.0.2",
    "ms": "^2.1.3",
    "node-cron": "^4.2.1",
    "nodemailer": "^7.0.9",
    "pm2": "^6.0.13",
    "resend": "^6.2.0",
    "socket.io": "^4.8.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/ms": "^2.1.0",
    "@types/node": "^24.8.1",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^7.0.2",
    "@typescript-eslint/eslint-plugin": "^8.30.1",
    "@typescript-eslint/parser": "^8.30.1",
    "eslint": "^9.25.0",
    "eslint-config-prettier": "^10.1.2",
    "eslint-plugin-prettier": "^5.2.6",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.4",
    "prettier": "^3.5.3",
    "prisma": "^6.17.1",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.30.1"
  },
  "imports": {
    "#config": "./dist/config/index.js",
    "#templates/*": "./dist/templates/*.js",
    "#controllers/*": "./dist/controllers/*.js",
    "#middlewares/*": "./dist/middlewares/*.js",
    "#schemas/*": "./dist/schemas/*.js",
    "#jobs/*": "./dist/jobs/*.js",
    "#workers/*": "./dist/workers/*.js",
    "#queues/*": "./dist/queues/*.js",
    "#routes/*": "./dist/routes/*.js",
    "#services/*": "./dist/services/*.js",
    "#libs/*": "./dist/libs/*.js",
    "#types/*": "./dist/types/*.js",
    "#monitoring/*": "./dist/monitoring/*.js",
    "#docs/*": "./dist/docs/*.js",
    "#sockets/*": "./dist/sockets/*.js"
  },
  "_moduleAliases": {
    "#src": "dist",
    "#templates": "dist/templates",
    "#config": "dist/config",
    "#controllers": "dist/controllers",
    "#schemas": "dist/schemas",
    "#jobs": "dist/jobs",
    "#workers": "dist/workers",
    "#queues": "dist/queues",
    "#middleware": "dist/middleware",
    "#services": "dist/services",
    "#routes": "dist/routes",
    "#libs": "dist/libs",
    "#types": "dist/types",
    "#monitoring": "dist/monitoring",
    "#docs": "dist/docs",
    "#sockets": "dist/sockets"
  }
}
